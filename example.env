# Main domain for all services and emails account.
INITDOMAIN=example.test

# Postgres user and password
PG_USER=root
PG_PASS=toor

# One password for all users accounts
GLOBAL_PASS=password

# System versions
RT_VERSION=6.0.2
RTIR_VERSION=6.0.1
# Platform for RTIR: amd64 or arm
RTIR_PLATFORM=amd64

POSTGRES_RELEASE=18-alpine3.23
DOCKER_MAILSERVER_RELEASE=15.1.0
ROUNDCUBE_RELEASE=1.6.13-apache
UBUNTU_RELEASE=24.04
ADMINER_RELEASE=5.4.2

# For MAC (arm) please use 10.11.8 version
MM_RELEASE=11.5.1
# 'mattermost-enterprise-edition' or 'mattermost-team-edition'
MM_EDITION=mattermost-team-edition
PYTHON_RELEASE=3.14.3
